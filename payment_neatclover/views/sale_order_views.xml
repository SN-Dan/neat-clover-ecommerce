        <field name="state">code</field>
        <field name="code">if records:
    action = records.action_open_clover_vt_popup()
        </field>
    </record>

    <record id="action_refund_by_neatclover_sale_order" model="ir.actions.server">
        <field name="name">Refund by Clover</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">if records:
    action = records.action_open_neatclover_refund_popup()
        </field>
