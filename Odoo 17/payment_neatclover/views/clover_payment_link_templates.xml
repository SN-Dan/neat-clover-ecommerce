<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="clover_payment_link_page" name="Clover Payment Link Page">
        <t t-call="web.html_container">
            <div class="container py-4">
                <h2>Payment</h2>
                <div class="mb-2">
                    <strong>Reference:</strong>
                    <span t-esc="reference"/>
                </div>
                <t t-if="link_status == 'paid' or link_is_paid">
                    <div class="alert alert-success" role="alert">
                        This payment link is paid.
                    </div>
                </t>
                <t t-elif="link_status == 'pending'">
                    <div class="alert alert-info" role="alert">
                        Payment is pending.
                    </div>
                </t>
                <t t-elif="status == 'failure'">
                    <div class="alert alert-danger" role="alert">
                        Payment failed. Please try again.
                    </div>
                </t>
                <t t-elif="status == 'cancel' or link_status == 'cancel'">
                    <div class="alert alert-warning" role="alert">
                        Payment was cancelled.
                    </div>
                </t>
                <t t-elif="link_status == 'error'">
                    <div class="alert alert-danger" role="alert">
                        Payment failed. Please try again.
                    </div>
                </t>
                <t t-if="payment_error">
                    <div class="alert alert-danger" role="alert">
                        <t t-esc="payment_error"/>
                    </div>
                </t>

                <div class="card mt-3">
                    <div class="card-body">
                        <t t-if="sale_orders">
                            <h5 class="card-title mb-3">Sales orders</h5>
                            <ul class="list-unstyled mb-3">
                                <t t-foreach="order_pay_lines" t-as="line">
                                    <li class="d-flex justify-content-between align-items-center border-bottom py-2">
                                        <a t-att-href="line.get('portal_url')" target="_blank" rel="noopener noreferrer">
                                            <t t-esc="line.get('name')"/>
                                        </a>
                                        <span>
                                            <t t-esc="currency_symbol"/>
                                            <t t-esc="'%.2f' % line.get('amount')"/>
                                        </span>
                                    </li>
                                </t>
                            </ul>
                        </t>
                        <t t-else="">
                            <h5 class="card-title mb-3">Invoices</h5>
                            <ul class="list-unstyled mb-3">
                                <t t-foreach="invoices" t-as="invoice">
                                    <li class="d-flex justify-content-between align-items-center border-bottom py-2">
                                        <a t-att-href="invoice.get_portal_url() or ('/web#id=%s&amp;model=account.move&amp;view_type=form' % invoice.id)" target="_blank" rel="noopener noreferrer">
                                            <t t-esc="invoice.name or invoice.ref or ('INV-%s' % invoice.id)"/>
                                        </a>
                                        <span>
                                            <t t-esc="invoice.currency_id.symbol or ''"/>
                                            <t t-esc="'%.2f' % invoice.amount_total"/>
                                        </span>
                                    </li>
                                </t>
                            </ul>
                        </t>
                        <div class="fw-bold">
                            Total:
                            <t t-esc="currency_symbol"/>
                            <t t-esc="'%.2f' % amount_total"/>
                        </div>
                    </div>
                </div>

                <t t-if="not link_is_paid and link_status != 'paid'">
                    <div class="mt-3">
                        <button id="neatclover_link_pay_btn" type="button" class="btn btn-primary">Pay</button>
                    </div>
                </t>
                <input type="hidden" id="neatclover_payment_url" t-att-value="payment_url or ''"/>
                <input type="hidden" id="neatclover_use_iframe" t-att-value="'1' if neatclover_use_iframe else '0'"/>

                <div id="neatclover_popup" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 9999;">
                    <div style="background: #fff; padding: 20px; max-height: 700px; overflow: auto; width: 100%; max-width: 800px; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3); border-radius: 10px; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
                        <div id="neatclover-container"></div>
                    </div>
                </div>

                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        const btn = document.getElementById('neatclover_link_pay_btn');
                        const paymentUrlInput = document.getElementById('neatclover_payment_url');
                        const useIframeInput = document.getElementById('neatclover_use_iframe');
                        const paymentUrl = paymentUrlInput ? paymentUrlInput.value : '';
                        const useIframe = (useIframeInput ? useIframeInput.value : '1') === '1';
                        if (!btn) {
                            return;
                        }
                        btn.addEventListener('click', async function () {
                            if (!paymentUrl) {
                                alert('Clover integration is not active. Please update the activation code.');
                                return;
                            }
                            if (useIframe) {
                                const popup = document.querySelector('#neatclover_popup');
                                if (popup) popup.style.display = 'block';
                                const customOptions = {
                                    url: paymentUrl,
                                    type: 'iframe',
                                    inject: 'immediate',
                                    target: 'neatclover-container',
                                    accessibility: true,
                                    debug: false,
                                    resultCallback: (responseData) => {
                                        const status = responseData.order.status;
                                        if (status === 'cancelled_by_shopper') {
                                            location.reload();
                                        }
                                    }
                                };
                                const libraryObject = new WPCL.Library();
                                libraryObject.setup(customOptions);
                            } else {
                                window.top.location.href = paymentUrl;
                            }
                        });
                    });
                </script>
            </div>
        </t>
    </template>
</odoo>
