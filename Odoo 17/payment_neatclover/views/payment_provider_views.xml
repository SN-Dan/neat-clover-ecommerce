<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Neat Clover Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position='inside'>
                <group invisible="code != 'neatclover'">
                    <script type="text/javascript" src="/payment_neatclover/static/src/js/neatclover.js"/>
                    <link rel="stylesheet" href="/payment_neatclover/static/src/css/neatclover.css"/>
                    <div class="alert alert-success" role="alert" colspan="2" invisible="neatclover_activation_code">
                        Don't have an Activation Code yet?<br />
                          
                        <a href="#" name="activation-code-button" onclick="showActivationForm(event)">
                        Get a free activation code
                        </a>
                        
                        <div id="neatclover_form" class="neatclover-popup">
                            <h3>Request an Activation Code</h3>
                            <div id="neatclover_request_form">

                            </div>
                            <a href="#" class="neatclover_submit" name="neatclover_submit">Submit</a>
                            <a href="#" class="neatclover_close_form" name="neatclover_close_form">Cancel</a>
                        </div>
                    </div> 
                    <field
                        name="neatclover_reset_code"
                        string="Update Module Cache"
                        required="code == 'neatclover' and state != 'disabled'"
                    />
                    <field
                        name="neatclover_activation_code"
                        string="Activation Code"
                        password="True"
                        required="code == 'neatclover' and state != 'disabled'"
                    />
                    <field
                        name="neatclover_store_id"
                        string="Clover Store ID"
                    />
                    <field
                        name="neatclover_public_key"
                        string="Clover Public Key"
                        required="code == 'neatclover' and state != 'disabled'"
                    />
                    <field
                        name="neatclover_private_key"
                        string="Clover Private Key"
                        password="True"
                        required="code == 'neatclover' and state != 'disabled'"
                    />
                    <!-- <field
                        name="neatclover_use_iframe"
                        string="Use iFrame"
                        required="code == 'neatclover' and state != 'disabled'"
                    /> -->
                    <field
                        name="neatclover_connection_url"
                        string="Odoo Server URL"
                        required="code == 'neatclover' and state != 'disabled'"
                    />
                    <field
                        name="neatclover_fallback_user_id"
                        string="Fallback Failure User"
                        required="code == 'neatclover' and state != 'disabled'"
                    />
                    <div class="alert alert-success" role="alert" colspan="2">
                        <b>By using this module you agree to our </b>
                        <a href="#" onclick="showTermsPopup(event)">
                        terms and conditions
                        </a>
                        <div id="neatclover_terms_popup" class="neatclover-popup neatclover-terms-popup">
                            <h3>Terms and Conditions</h3>
                            <div id="neatclover_terms_content" class="neatclover-terms-content">
                                Loading...
                            </div>
                            <a href="#" class="neatclover_close_terms" name="neatclover_close_terms">Close</a>
                        </div>
                    </div>
                   <!-- <div class="oe_structure" colspan="2">
                        <p>
                            Please make sure to set the following webhook in the Clover Dashboard:
                        </p>
                        <p><strong>{Odoo Server URL}/neatclover/wh</strong></p>
                    </div> -->
                </group>
            </group>
        </field>
    </record>
</odoo>
