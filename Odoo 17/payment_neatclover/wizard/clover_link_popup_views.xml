<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="clover_link_popup_view_form" model="ir.ui.view">
        <field name="name">clover.link.popup.form</field>
        <field name="model">clover.link.popup</field>
        <field name="arch" type="xml">
            <form string="Pay by Clover Link">
                <group>
                    <field name="provider_id" options="{'no_create': True}"/>
                    <field name="reference" readonly="1"/>
                    <field name="payment_link" readonly="1" widget="CopyClipboardChar"/>
                </group>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
