<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="clover_vt_popup_view_form" model="ir.ui.view">
        <field name="name">clover.vt.popup.form</field>
        <field name="model">clover.vt.popup</field>
        <field name="arch" type="xml">
            <form string="Pay by Clover Virtual Terminal" style="max-width: 462px;">
                <field name="payment_page_html" readonly="1" nolabel="1" widget="html"/>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
