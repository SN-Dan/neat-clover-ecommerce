<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_method_neatclover" model="payment.method">
        <field name="name">Clover</field>
        <field name="code">neatclover</field>
        <field name="image" type="base64"
            file="payment_neatclover/static/description/icon.png" />
    </record>
    <record id="payment_provider_neatclover" model="payment.provider">
        <field name="code">neatclover</field>
        <field name="name">Clover</field>
        <field name="inline_form_view_id" ref="inline_form"/>
        <field name="allow_tokenization">False</field>
        <field name="image_128" type="base64"
            file="payment_neatclover/static/description/icon.png" />
        <field name="module_id" ref="base.module_payment_neatclover" />
        <field name="payment_method_ids"
                eval="[Command.set([ref('payment_neatclover.payment_method_neatclover')])]" />
    </record>

</odoo>