<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="cron_neatclover_finalise_payment" model="ir.cron">
            <field name="name">neatclover Finalise Payment</field>
            <field name="model_id" ref="payment_neatclover.model_neatclover_finalise_payment"/>
            <field name="state">code</field>
            <field name="code">model._cron_finalise_payment()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.utcnow() + relativedelta(minutes=-1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
